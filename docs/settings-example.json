{
  "_comment": "Snippet to merge into ~/.claude/settings.json. Replace any existing 'statusLine' entry. Add the UserPromptSubmit, StopFailure and SubagentStop blocks under 'hooks'. Add the SessionStart block alongside any existing SessionStart hooks. Both SessionStart hooks can run side by side: Claude Code joins the additionalContext of every hook, and only rl-session-name.js sets sessionTitle.",

  "statusLine": {
    "type": "command",
    "command": "node \"%USERPROFILE%/.claude/hooks/rl-statusline.js\""
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent|Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-gate.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/agent-control.js\"",
            "timeout": 600
          }
        ]
      }
    ],

    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-warn.js\"",
            "timeout": 5
          }
        ]
      }
    ],

    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-stop-failure.js\"",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],

    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-release.js\"",
            "timeout": 10
          }
        ]
      }
    ],

    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-session-start.js\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"%USERPROFILE%/.claude/hooks/rl-session-name.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
